# Add these values to the environment of the Hermes process (or its profile .env).
HERMES_CF_ENDPOINT=https://your-worker.your-subdomain.workers.dev
# Generate a new random secret and set the SAME value as the Worker secret SANDBOX_API_TOKEN.
HERMES_CF_TOKEN=
# Optional stable identities. Pick a different namespace per user/profile.
HERMES_CF_NAMESPACE=personal
# Leave this unset for per-task workspaces. Set it to resume one project across task IDs.
# Do not share one named workspace between simultaneously running Hermes processes.
# HERMES_CF_WORKSPACE=my-project
HERMES_CF_IMAGE=hermes
# Must be in the Worker's ALLOWED_INSTANCE_TYPES. Unset uses the Worker's default.
# HERMES_CF_INSTANCE=standard-1
# Optional Cloudflare Access service token; these fields must be set together.
# HERMES_CF_ACCESS_CLIENT_ID=
# HERMES_CF_ACCESS_CLIENT_SECRET=
